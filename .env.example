# Server
# Non-Docker: 127.0.0.1:8080  (localhost only, behind a reverse proxy)
# Docker:     0.0.0.0:8080    (Caddy/nginx can't reach 127.0.0.1 across containers)
ADDR=127.0.0.1:8080

# SQLite database path
# Non-Docker: ./banktoactual.db
# Docker:     /app/data/banktoactual.db  (persisted via named volume db-data)
SQLITE_PATH=./banktoactual.db

# Uploaded files directory (kept indefinitely for retry)
# Non-Docker: ./uploads
# Docker:     /app/uploads  (persisted via named volume uploads)
UPLOAD_DIR=./uploads

# Actual Budget (via actual-http-api)
# See: https://github.com/jhonderson/actual-http-api
# Non-Docker: ACTUAL_API_URL=http://localhost:5007
# Docker:     ACTUAL_API_URL=http://actual-http-api:5007  (use the compose service name)
ACTUAL_API_URL=http://localhost:5007
ACTUAL_API_KEY=your-api-key
ACTUAL_BUDGET_SYNC_ID=your-budget-sync-id
