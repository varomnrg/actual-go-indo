# Server
# Use 127.0.0.1:8080 to bind localhost only (recommended behind a reverse proxy)
# Use 0.0.0.0:8080 only inside Docker (Caddy/nginx can't reach 127.0.0.1 across containers)
ADDR=127.0.0.1:8080
SQLITE_PATH=./banktoactual.db

# File storage (uploaded PDFs/XLSX kept indefinitely for retry)
UPLOAD_DIR=./uploads

# Actual Budget (via actual-http-api Docker container)
# See: https://github.com/jhonderson/actual-http-api
ACTUAL_API_URL=http://localhost:5007
ACTUAL_API_KEY=your-api-key
ACTUAL_BUDGET_SYNC_ID=your-budget-sync-id
